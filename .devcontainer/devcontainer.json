Here's the updated server.js with per-session conversation memory:

import express from "express"
import http from "http"
import { Server } from "socket.io"
import cors from "cors"
import dotenv from "dotenv"
import OpenAI from "openai"

dotenv.config()

const app = express()
app.use(cors())
app.use(express.static("public"))

const server = http.createServer(app)
const io = new Server(server)

const openai = new OpenAI({
  apiKey: process.env.OPENAIAPIKEY
})

const SYSTEM_PROMPT = {
  role: "system",
  content: "You are AI Pulse, a powerful real-time AI assistant that helps with any task."
}

const MAX_HISTORY = 20

io.on("connection", (socket) => {
  console.log("User connected:", socket.id)

  // Each socket gets its own conversation history
  const history = []

  socket.on("message", async (msg) => {

    // Basic input validation
    if (!msg || typeof msg !== "string" || msg.trim().length === 0) {
      socket.emit("reply", "Please enter a valid message.")
      return
    }

    if (msg.length > 2000) {
      socket.emit("reply", "Message too long. Please keep it under 2000 characters.")
      return
    }

    // Add user message to this session's history
    history.push({ role: "user", content: msg.trim() })

    // Trim history if it gets too long, but always keep the system prompt separate
    if (history.length > MAX_HISTORY) {
      history.splice(0, 2) // Remove oldest user+assistant pair
    }

    try {
      const completion = await openai.chat.completions.create({
        model: "gpt-4o-mini",
        messages: [SYSTEM_PROMPT, ...history],
        max_tokens: 1000
      })

      const reply = completion.choices[0].message.content

      // Add assistant reply to history so future messages have context
      history.push({ role: "assistant", content: reply })

      socket.emit("reply", reply)

    } catch (error) {
      console.error("OpenAI error:", error.message)

      // Don't add failed exchanges to history
      history.pop()

      socket.emit("reply", "Something went wrong. Please try again.")
    }
  })

  socket.on("disconnect", () => {
    console.log("User disconnected:", socket.id)
    // History is automatically garbage collected when socket closes
  })
})

server.listen(3000, () => {
  console.log("AI Pulse running on http://localhost:3000")
})

The key changes and why they matter:

Each socket connection now gets its own history array that lives for the duration of that session. When a user sends a message, the full conversation so far gets passed to OpenAI, so the AI can reference anything said earlier. When the user disconnects, the history disappears automatically since it was just a local variable in that connection's scope.

The MAX_HISTORY cap prevents the context window from growing forever and keeps your API costs predictable. It trims the oldest pairs when the limit is hit, which means very long conversations will gradually lose their earliest context, but that's usually acceptable behavior.

The failed exchange handling is worth noting: if the OpenAI call fails, the user message gets removed from history with history.pop(). This prevents a situation where the AI's history shows a user message with no corresponding reply, which can confuse the model on future turns.

