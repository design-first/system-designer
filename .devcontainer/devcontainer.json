function isRateLimited(id) {
  const now = Date.now()
  const limit = rateLimit.get(id) || []

  const filtered = limit.filter(t => now - t < 60000)

  if (filtered.length >= 10) return true

  filtered.push(now)
  rateLimit.set(id, filtered)

  return false
}if (isRateLimited(socket.id)) {
